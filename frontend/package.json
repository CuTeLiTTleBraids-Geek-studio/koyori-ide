{
  "name": "frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "bindings:generate": "node ../scripts/generate-bindings.mjs",
    "predev": "npm run bindings:generate",
    "dev": "vite",
    "prebuild:dev": "npm run bindings:generate",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "prebuild": "npm run bindings:generate",
    "build": "vue-tsc && vite build --mode production",
    "postbuild": "node ../scripts/check-http-client-production.mjs",
    "preview": "vite preview",
    "pretest": "npm run bindings:generate",
    "test": "vitest run",
    "pretest:watch": "npm run bindings:generate",
    "test:watch": "vitest",
    "pretest:coverage": "npm run bindings:generate",
    "test:coverage": "vitest run --coverage",
    "prelint": "npm run bindings:generate",
    "lint": "eslint src"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^14.3.0",
    "@wailsio/runtime": "3.0.0-alpha.95",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "animate.css": "^4.1.1",
    "dompurify": "^3.4.13",
    "element-plus": "^2.14.2",
    "emmet-monaco-es": "5.7.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "monaco-editor": "^0.52.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.2.45",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.9"
  }
}
