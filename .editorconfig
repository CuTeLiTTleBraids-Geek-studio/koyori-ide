# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
tab_width = 4

[*.{js,mjs,cjs,ts,tsx,vue,json,jsonc,yml,yaml,html,css,scss,svg,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.cmd,*.bat,*.ps1}]
end_of_line = crlf