<?xml version="1.0" encoding="UTF-8"?>
<!--
  Koyori IDE MSI installer definition (WiX Toolset v3).

  Built from bin/koyori-ide.exe (compiled by build/scripts/build-windows.ps1).
  Preprocessor variables are injected by build/scripts/build-msi.ps1:
    - Version      numeric MSI product version (VERSION with pre-release suffix stripped)
    - AppExe       absolute path to bin/koyori-ide.exe
    - Icon         absolute path to build/windows/icon.ico
    - UpgradeCode  stable upgrade GUID (never change between versions)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Koyori IDE"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Koyori IDE Contributors"
           UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="Koyori IDE Contributors"
             Description="Koyori IDE - AI-Powered Coding Desktop App"
             Comments="Offline-first desktop AI IDE for Go and TypeScript/JavaScript"
             Keywords="IDE,Editor,AI,Koyori" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="AI-Powered Coding Desktop App for Professional Developers" />
    <Property Id="ARPHELPLINK" Value="https://github.com/CuTeLiTTleBraids-Geek-studio/koyori-ide" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Koyori IDE" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Koyori IDE" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="KoyoriIdeExe"
              Name="koyori-ide.exe"
              Source="$(var.AppExe)"
              KeyPath="yes" />
      </Component>
      <Component Id="AppIconFile" Guid="*">
        <File Id="KoyoriIdeIcon"
              Name="koyori-ide.ico"
              Source="$(var.Icon)"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Koyori IDE"
                  Description="Koyori IDE"
                  Target="[INSTALLFOLDER]koyori-ide.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  IconIndex="0" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Koyori IDE"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainProduct" Title="Koyori IDE" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppIconFile" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
